{
  "name": "drops-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "serve:test": "DROPSTAB_API_KEY= DROPS_STUDIO_LOCAL_PROJECT_STORE=1 DROPS_PUBLISH_CAPABILITY_SECRET=drops-studio-local-proof-secret-not-for-production next start -p 4173 -H 127.0.0.1",
    "serve:lighthouse": "DROPSTAB_API_KEY= next start -p 4274 -H 127.0.0.1",
    "guardrails:ui": "node scripts/check-ui-guardrails.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build:vercel && playwright test",
    "test:e2e:prepared": "playwright test",
    "test:visual": "npm run build:vercel && playwright test e2e/visual",
    "test:a11y": "npm run build:vercel && playwright test e2e/accessibility",
    "test:lighthouse": "npm run build:vercel && lhci autorun",
    "test:lighthouse:prepared": "lhci autorun",
    "storybook": "storybook dev -p 6006 --ci",
    "serve:storybook:test": "DROPSTAB_API_KEY= node scripts/serve-storybook-static.mjs",
    "build-storybook": "storybook build --output-dir outputs/storybook-static",
    "postinstall": "node scripts/patch-minimatch-brace-compat.mjs",
    "test:storybook": "vitest --project=storybook --run",
    "test:storybook:visual": "playwright test --config=playwright.storybook.config.ts",
    "test:proofs": "npm run build:vercel && playwright test e2e/proofs --project=chromium-1440",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern outputs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@vercel/blob": "^2.6.1",
    "@vercel/sandbox": "2.9.0",
    "ai": "^7.0.41",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "22.4.0",
    "tailwind-merge": "3.6.0",
    "teleproto": "^1.228.4",
    "tw-animate-css": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "^1.48.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.16.0",
    "storybook": "10.5.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "cosmiconfig": {
      "js-yaml": "4.3.0"
    },
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "type": "module"
}
