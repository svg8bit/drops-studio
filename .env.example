# Stable HMAC secret for signed anonymous identity and daily-build quotas.
# Required for platform-funded guest AI in production; never substitute the rotating Vercel OIDC token.
DROPS_GUEST_COOKIE_SECRET=

# Stable HMAC secret for the signed OpenRouter-backed Studio member session.
# May equal DROPS_GUEST_COOKIE_SECRET during an MVP, but should be independently rotated in production.
DROPS_ACCOUNT_COOKIE_SECRET=

# Stable 32+ byte HMAC secret for browser-held publish management capabilities.
# Rotating it makes existing managed public links read-only in their original browsers.
DROPS_PUBLISH_CAPABILITY_SECRET=

# Optional platform-owned key. When omitted, public demos use a clearly labelled fallback feed.
DROPSTAB_API_KEY=

# Telegram MTProto application credentials for explicit user-account connection.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Separate encryption material for sealed Telegram session tokens.
TELEGRAM_SESSION_ENCRYPTION_KEY=

# Preferred platform bot used only after the user approves real channel creation.
DROPS_STUDIO_TELEGRAM_BOT_TOKEN=

# Durable production storage/rate-limit backends (provider supplies OIDC where applicable).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# AI Gateway is normally authenticated by Vercel OIDC. Set an explicit key only outside that flow.
AI_GATEWAY_API_KEY=

# Stripe Billing and signed team collaboration. Values are configured only in the provider environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
DROPS_TEAM_INVITE_SECRET=
